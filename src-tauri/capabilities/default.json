{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos básicos para mi app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-save",
    "fs:allow-write-file",
    "fs:allow-read-file",
    "fs:allow-exists",
    {
      "identifier": "fs:allow-desktop-write",
      "allow": [{ "path": "$DESKTOP/*" }]
    },
    {
      "identifier": "fs:allow-download-write",
      "allow": [{ "path": "$DOWNLOAD/*" }]
    }
  ]
}